# =============================================================================
# 本地目录：不入库
#   docs/   —— 实测证据（记分卡、L1/L3/L4 报告）：结论已写入 README 与两份设计文档
#   _deps/  —— **工具链脚本入库**（见下方白名单），依赖与运行产物不入库
# =============================================================================
/docs/

# =============================================================================
# 上游 WebKit 稀疏检出（约 4.1 GB，其中 .git 2.7 GB）——不入库
# 获取方式见 README「复现步骤」：git clone --sparse + sparse-checkout set …
# 本次移植的全部改动见 port/port-changes.patch
# =============================================================================
/WebKit-JavaScriptCore/

# =============================================================================
# _deps/：只保留工具链脚本（构建 / 依赖获取 / 打包 / 测试链 / 一键记分卡）
#        其余一律忽略：ICU 与 Ruby 依赖、test262 检出、下载包、运行产物与日志
# =============================================================================
/_deps/*
!/_deps/*.ps1
!/_deps/*.js
!/_deps/t262/
!/_deps/l3/
!/_deps/l4/
!/_deps/stage2_test/
!/_deps/stage5/

/_deps/t262/*
!/_deps/t262/*.py
!/_deps/t262/*.sh
!/_deps/t262/*.ps1

/_deps/l3/*
!/_deps/l3/*.ps1
!/_deps/l3/*.sh
!/_deps/l3/*.js

/_deps/l4/*
!/_deps/l4/run_l4.ps1

/_deps/stage2_test/*
!/_deps/stage2_test/*.cpp

/_deps/stage5/*
!/_deps/stage5/*.js

# =============================================================================
# 构建产物
# =============================================================================
build-android/
build-android-testapi/
build-off/
**/build/
**/.gradle/
**/.idea/
**/local.properties
**/captures/
**/.cxx/
.cxx/

# =============================================================================
# 二进制 / 大文件（APK 内 jniLibs 的 .so、ICU 数据、设备端产物等）
# =============================================================================
**/jniLibs/**/*.so
**/jniLibs/**/*.a
*.so
*.a
*.o
*.obj
*.dex
*.jar
!MyApplication/gradle/wrapper/gradle-wrapper.jar
*.apk
*.ap_
*.dat
*.b64
*.tar.gz
*.zip
*.exe
*.dll

# =============================================================================
# 日志 / 临时文件 / 工作区数据
# =============================================================================
*.log
*.err
*.out
*.pid
Thumbs.db
Desktop.ini
.codebuddy/
deps/
